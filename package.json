{
  "name": "toolbridge-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first AI workspace with real MCP tool discovery and approval-gated actions.",
  "engines": { "node": ">=22.16" },
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server/index.ts",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/core.test.mjs tests/integration.test.mjs",
    "test:core": "node --experimental-transform-types --test tests/core.test.mjs",
    "test:http": "npm run build && node --test tests/http.test.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "check": "npm test && npm run test:http"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^16.6.1",
    "openai": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7"
  }
}
