# Copy to .env locally. Never commit your keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# gpt-6-luna requires "none" for tool calling through Chat Completions.
# Leave empty to omit this parameter for models or providers that reject it.
OPENAI_REASONING_EFFORT=none
# Optional: trusted OpenAI-compatible provider. Keys are sent to this URL.
OPENAI_BASE_URL=https://api.openai.com/v1
# Required only for web_search; obtain a key from https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Optional: improves the public GitHub search rate limit. Use a read-only token.
GITHUB_TOKEN=
PORT=4317
